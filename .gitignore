# --- Go ---
/bin/
/dist/
*.exe
*.test
*.out
coverage.*
__debug_bin*

# --- Node / UI ---
node_modules/
# ⛔ THE CONTENTS, NOT THE DIRECTORY, AND `.gitkeep` SURVIVES. `web/embed.go`
# embeds `all:dist`, and a `go:embed` pattern that matches NOTHING is a compile
# error — so ignoring the directory itself would break `go build ./...` on every
# fresh clone until somebody ran `npm run build`. Git also cannot re-include a
# file whose parent directory is excluded, which is why this is `web/dist/*`
# rather than `web/dist/`.
web/dist/*
!web/dist/.gitkeep
web/.vite/
web/coverage/
web/test-results/
web/playwright-report/
*.tsbuildinfo

# --- Local environment (never commit real credentials) ---
.env
.env.*
!.env.example
*.local.yml
*.local.yaml
config.local.*
# The dev Alertmanager's webhook URL and ingest token, rendered by `just am-wire`.
deploy/alertmanager/local/

# --- Editors and OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# --- Tooling caches ---
.golangci-cache/
.tmp/
# A locally-run scarab-server writes its object store INSIDE .scarab/
# (SCARAB_OBJECT_DIR defaults to ./.scarab/objects). Ignore that path and
# only that path: .scarab/build.yaml beside it is tracked source, and a
# blanket /.scarab rule would silently swallow it.
/.scarab/objects/
